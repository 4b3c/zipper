# zipper -- SECRETS ONLY. Copy to .env (gitignored) and fill in what you use.
#
# Everything that is not a secret -- the vault path, which inputs run, ports,
# channel ids, the schedule -- lives in zipper.settings.json (see
# zipper.settings.example.json, or run `zipper setup`). The agent reads and edits
# that file; it never opens this one. An older .env holding both can be split
# with `zipper settings migrate`.
#
# Precedence, everywhere: the real environment, then this file, then settings.

# GitHub, for reading. Without it you see public repos only.
GITHUB_TOKEN=

# The Discord bot's token (developer portal -> your application -> Bot).
DISCORD_TOKEN=

# The embedded terminal is a live shell. It will not bind off loopback without a
# credential: user:password, no spaces.
ZIPPER_TERM_CRED=

# Google OAuth, for the timesheet. `zipper google --auth` fills the refresh token.
ZIPPER_GOOGLE_CLIENT_SECRET=
ZIPPER_GOOGLE_REFRESH_TOKEN=

# Shared by the zippers on one host: a message from a peer must carry it.
ZIPPER_COMMS_TOKEN=

# Optional: bill Claude to an API key instead of a claude.ai login.
ANTHROPIC_API_KEY=

# The browser extension's signing (addons.mozilla.org), and web-ext's record of
# the last upload -- build state, kept here only so it is not loose in the tree.
AMO_JWT_ISSUER=
AMO_JWT_SECRET=
AMO_UPLOAD_UUID=
AMO_XPI_CRC_HASH=
AMO_CHANNEL=unlisted
