{
  "manifest_version": 3,
  "name": "Zipper Collector",
  "version": "0.5.0",
  "description": "Reads what only a logged-in browser can see, and hands it to Zipper. Collects; never concludes.",

  "background": {
    "service_worker": "background.js",
    "type": "module",
    "scripts": ["background.js"]
  },

  "content_scripts": [
    {
      "matches": ["https://canvas.asu.edu/*", "*://*.instructure.com/*"],
      "js": ["collectors/canvas.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://canvas.asu.edu/*", "*://*.instructure.com/*"],
      "js": ["ui/canvas-todo.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://docs.google.com/spreadsheets/d/*"],
      "js": ["ui/sheet-hours.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://canvas.asu.edu/courses/*", "*://*.instructure.com/courses/*"],
      "js": ["ui/canvas-files.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://cad.onshape.com/*", "https://*.prairielearn.com/*",
                  "https://canvas.asu.edu/*", "*://*.instructure.com/*",
                  "https://github.com/*", "https://docs.google.com/*"],
      "js": ["collectors/sitetime.js"],
      "run_at": "document_idle"
    }
  ],

  "permissions": ["storage", "idle"],

  "host_permissions": ["https://canvas.asu.edu/*", "*://*.instructure.com/*",
                       "https://*.inscloudgate.net/*"],

  "optional_host_permissions": ["http://*/*", "https://*/*"],

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "zipper-collector@zipper.local",
      "update_url": "__ZIPPER_EXT_BASE__/ext/updates.json"
    }
  }
}
